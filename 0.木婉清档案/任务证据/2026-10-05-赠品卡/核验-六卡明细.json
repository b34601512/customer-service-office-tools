  {
    "name": "01-dedakj旗舰店",
    "endpoint": "/api/kbe/v1/knowledge-card/detail?id=6ac38522e4bec54754834d1b",
    "method": "GET",
    "httpStatus": 200,
    "businessCode": 1,
