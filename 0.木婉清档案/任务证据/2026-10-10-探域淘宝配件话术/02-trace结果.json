        {
          "docId": "6ac1ccafea5b2c73dbfc043a",
          "chunkId": "6ac0a23d42a160171beee67c",
          "type": "DETAIL",
          "label": null,
          "content": "【无耗材制氧】\n一键制氧，无需添加制氧剂，采用PSA发明专利，专利号ZL201814867212。",
