{"api_version": 1, "request_id": "0dc669e1-dc5c-4d95-bd1e-c556f1b52b55", "operation_id": "12542257-f217-49a2-b45e-138a6470716d", "ok": true, "data": {"phrase_id": "49638fc8-66d1-4d23-8d4c-3f9250611831", "scope": "team", "phrase_set": 0, "question": "60\u7ecf\u5e38\u8981\u6362\u6ee4\u82af\u5417\uff1f\u591a\u4e45\u6362\u4e00\u6b21\uff1f", "background": "", "category_id": "a14bc195-7b60-408d-bf09-61e235996386", "hotkey": "", "revision": 2, "created_origin": "unknown", "last_modified_origin": "automation", "created_connection_id": "", "last_connection_id": "77ffaf12-a881-4bde-95c3-0276fc1641ea", "document_version": 0, "content": [{"type": "text", "text": "1.\u4eb2\u4eb2\uff0c\u5236\u6c27\u672c\u8eab\u662f\u6ca1\u6709\u8017\u6750\u7684\u54c8~\u4e0d\u8fc7\u673a\u5668\u91cc\u9762\u6709\u4e2a\u5185\u7f6e\u8fc7\u6ee4\u5668\uff0c\u662f\u7528\u6765\u8fc7\u6ee4\u7a7a\u6c14\u4e2d\u7070\u5c18\u7684\uff5e\u56e0\u4e3a\u5236\u6c27\u673a\u662f\u5438\u5165\u7a7a\u6c14\u518d\u5236\u6c27\uff0c\u65f6\u95f4\u4e45\u4e86\u8fc7\u6ee4\u5668\u5bb9\u6613\u88ab\u7070\u5c18\u5835\u4f4f\uff0c\u53ef\u80fd\u4f1a\u5f71\u54cd\u8fdb\u6c14\uff0c\u6240\u4ee5\u662f\u9700\u8981\u5b9a\u671f\u66f4\u6362\u7684\u54e6\uff5e\n\n2.\u8fc7\u6ee4\u5668\u5176\u5b9e\u5bf9\u6211\u4eec\u633a\u91cd\u8981\u7684\uff0c\u5b83\u4e00\u65b9\u9762\u80fd\u6321\u6389\u7a7a\u6c14\u4e2d\u7684\u7070\u5c18\uff0c\u4fdd\u62a4\u6211\u4eec\u5438\u5165\u7684\u6c27\u6c14\u66f4\u5e72\u51c0\uff0c\u540c\u65f6\u4e5f\u80fd\u5ef6\u957f\u673a\u5668\u5bff\u547d\uff0c\u662f\u5fc5\u4e0d\u53ef\u5c11\u7684\u5c0f\u914d\u4ef6\u5462\uff5e\n\n3.\u4e00\u822c\u5efa\u8bae\u4f7f\u7528 100\uff5e500 \u5c0f\u65f6\u5de6\u53f3\u67e5\u770b\u4e00\u6b21\u54c8\uff0c\u5177\u4f53\u6362\u7684\u9891\u7387\u8fd8\u5f97\u770b\u4f7f\u7528\u73af\u5883\u548c\u65f6\u95f4\uff5e\u53ea\u8981\u53d1\u73b0\u989c\u8272\u53d8\u5f97\u5f88\u6df1\u3001\u53d8\u9ed1\u4e86\uff0c\u5c31\u53ef\u4ee5\u8003\u8651\u66f4\u6362\u54af\uff01"}], "assets": []}}
{"api_version": 1, "request_id": "0a4caec1-3d4b-404f-8818-6993a856c789", "operation_id": "80cce7c9-2893-4391-9893-cb67dddb0d8c", "ok": true, "data": {"phrase_id": "7f9f4f4f-82c3-4981-9b82-70cd0cc68efb", "scope": "team", "phrase_set": 0, "question": "\u5236\u6c27\u673a\u8017\u6750\u6210\u672c\u9ad8\u5417\uff1f", "background": "", "category_id": "a14bc195-7b60-408d-bf09-61e235996386", "hotkey": "", "revision": 2, "created_origin": "unknown", "last_modified_origin": "automation", "created_connection_id": "", "last_connection_id": "77ffaf12-a881-4bde-95c3-0276fc1641ea", "document_version": 0, "content": [{"type": "text", "text": "\u4eb2\u4eb2\uff5e\u5236\u6c27\u673a\u4e70\u56de\u53bb\u4e4b\u540e\u7684\u3010\u7ef4\u62a4\u6210\u672c\u662f\u6bd4\u8f83\u4f4e\u7684\u3011\u54e6\uff5e  \n\u4e3b\u8981\u8017\u6750\u5c31\u662f\u3010\u5438\u6c27\u7ba1 + \u8fc7\u6ee4\u5668/\u8fc7\u6ee4\u68c9\u3011\u4e24\u4e2a\u90e8\u5206\uff1a\n\n1. \u5438\u6c27\u7ba1\uff1a\u6bcf\u6b21\u7528\u5b8c\u7528\u6e05\u6c34\u51b2\u6d17\u5c31\u597d\uff0c\u6b63\u5e38\u4f7f\u7528\u4e00\u822c3-6\u4e2a\u6708\u6362\u4e00\u6b21\uff0c\u5341\u51e0\u4e8c\u5341\u5757\u94b1\uff5e  \n2. \u8fc7\u6ee4\u5668/\u8fc7\u6ee4\u68c9\uff1a\u6b63\u5e38\u4f7f\u7528\u80fd\u7528100\uff5e500\u5c0f\u65f6\u4ee5\u4e0a\uff0c\u5177\u4f53\u770b\u4f7f\u7528\u73af\u5883\uff0c\u66f4\u6362\u4e00\u6b21\u5927\u6982\u51e0\u5341\u5757\u94b1\uff5e\n\n\u6574\u4f53\u6765\u8bf4\u7ef4\u62a4\u7b80\u5355\u3001\u6210\u672c\u4e5f\u4e0d\u9ad8\uff0c\u653e\u5fc3\u4f7f\u7528\u5c31\u597d\u5566\uff5e\ud83d\ude0a"}], "assets": []}}
